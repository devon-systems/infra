# shellcheck disable=SC2148
export DIRENV_WARN_TIMEOUT=0

use flake .

export_sops_secret() {
  local variable_name="$1" secret_file="$2" secret_key="$3" value
  if value=$(sops --decrypt --extract "$secret_key" "$secret_file" 2>/dev/null); then
    export "$variable_name=$value"
  else
    unset "$variable_name"
    echo "direnv: could not decrypt $secret_file" >&2
  fi
}

export_sops_secret AWS_ACCESS_KEY_ID secrets/b2.yaml '["STATE_KEY_ID"]'
export_sops_secret AWS_SECRET_ACCESS_KEY secrets/b2.yaml '["STATE_APP_KEY"]'
export_sops_secret B2_APPLICATION_KEY_ID secrets/b2.yaml '["B2_KEY_ID"]'
export_sops_secret B2_APPLICATION_KEY secrets/b2.yaml '["B2_APP_KEY"]'
export_sops_secret TAILSCALE_API_KEY secrets/tailscale-api.yaml '["api_key"]'
